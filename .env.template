# AEGIS-DIMON Environment Configuration
# Copy this file to .env and fill in your actual values

# Gemini API Key (optional; ignored unless AEGIS_ENABLE_GOOGLE_PAID=1)
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (optional, defaults to SQLite)
DATABASE_URL=sqlite:///gemini_bridge.db

# Local-only blueprint
AEGIS_LOCAL_ONLY=1
AEGIS_LOCAL_PRIMARY_MODEL=gemma4:26b-a4b-it-q8_0
AEGIS_LOCAL_CODE_MODEL=gemma4:26b-a4b-it-q8_0
AEGIS_LOCAL_TOOL_MODEL=qwen2.5-coder:1.5b
AEGIS_LOCAL_TOOL_FALLBACK_MODEL=aegis-gemma2-abliterated:2b-q8
AEGIS_PICOCLAW_EXE=<REPO_ROOT>\vendor\picoclaw\picoclaw.exe
AEGIS_PICOCLAW_HOME=<REPO_ROOT>\vendor\picoclaw_runtime
AEGIS_PICOCLAW_MODEL_ALIAS=aegis-brain-agent
AEGIS_PICOCLAW_MODEL=aegis-gemma2-abliterated:2b-q8
AEGIS_PICOCLAW_API_BASE=http://127.0.0.1:11434/v1
AEGIS_PICOCLAW_PREFER_DIRECT=1
AEGIS_BROWSER_USE_PYTHON=<REPO_ROOT>\vendor\browser_use_venv\Scripts\python.exe
AEGIS_BROWSER_USE_MODEL=aegis-gemma2-abliterated:2b-q8
AEGIS_BROWSER_USE_OLLAMA_BASE_URL=http://127.0.0.1:11434
AEGIS_OLLAMA_API_BASE=http://127.0.0.1:11434
AEGIS_OLLAMA_PRIMARY_KEEP_ALIVE=20m
AEGIS_OLLAMA_TOOL_KEEP_ALIVE=8m
AEGIS_OLLAMA_EMBED_KEEP_ALIVE=4m
AEGIS_INCLUDE_REASONING_NOTES=0
AEGIS_VISIBLE_STATUS_UPDATES=0
AEGIS_VISIBLE_ROUND0_REPLY=0
AEGIS_INTENT_MARKERS_ENABLED=0
AEGIS_CHAT_DIRECTIVE_CAPTURE_ENABLED=0
AEGIS_OLLAMA_CHAT_TIMEOUT_SECONDS=240
AEGIS_OLLAMA_FIRST_TOKEN_TIMEOUT_SECONDS=75
AEGIS_OLLAMA_NUM_CTX_SIMPLE=2048
AEGIS_OLLAMA_NUM_CTX_DEFAULT=8192
AEGIS_OLLAMA_NUM_CTX_LONG=12288
AEGIS_WORKER_NUM_CTX=1024
AEGIS_PROGRAM_LOOP_NUM_CTX=3072
AEGIS_ENGINE_NUM_CTX=8192
AEGIS_RESPONSE_BUDGET_SIMPLE=1536
AEGIS_RESPONSE_BUDGET_DEFAULT=4096
AEGIS_RESPONSE_BUDGET_DELIBERATE=6144
AEGIS_RESPONSE_BUDGET_FULL=8192
AEGIS_RESPONSE_BUDGET_MAX=12000
AEGIS_SCRIPT_UBER_WEIGHT=1000
AEGIS_SCRIPT_REGISTRY_MAX_INLINE_BYTES=2097152
OLLAMA_KEEP_ALIVE=15m
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q4_0
AEGIS_ACTIVEPIECES_ENABLED=0
AEGIS_ACTIVEPIECES_BASE_URL=
AEGIS_SKYVERN_ENABLED=0
AEGIS_SKYVERN_BASE_URL=
AEGIS_OPENAI_ESCALATION_ENABLED=0
AEGIS_OPENAI_ESCALATION_MODEL=gpt-5
AEGIS_OPENAI_RESPONSES_API=1
AEGIS_OPENAI_PROJECT=
AEGIS_OPENAI_FILTER_TIMEOUT_SECONDS=45
OPENAI_API_KEY=

# Optional Intel Lava neuromorphic lane. Disabled until explicitly enabled.
# Lava is Intel's open-source framework for neuro-inspired/event-driven applications.
AEGIS_INTEL_LAVA_ENABLED=0
AEGIS_INTEL_LAVA_PYTHON=
AEGIS_INTEL_LAVA_BACKEND=cpu-simulation
AEGIS_INTEL_LAVA_WORKSPACE=<REPO_ROOT>\agentic_jobs\lava_neuromorphic

# Source-role map. These settings classify external knowledge without injecting it into prompts.
AEGIS_SOURCE_ROLE_REGISTRY_ENABLED=1
AEGIS_EXTERNAL_SOURCE_ROOT=<USER_HOME>\AIEngine\external_sources
AEGIS_FABRIC_PATTERN_ROOT=<USER_HOME>\AIEngine\external_sources\fabric\data\patterns
AEGIS_FABRIC_RAM_CACHE_ENABLED=1
AEGIS_FABRIC_RAM_CACHE_MAX_MB=500
AEGIS_FABRIC_VRAM_CHOOSER_ENABLED=1
AEGIS_EXTERNAL_SOURCES_ACTIVE_IN_PROMPT=0
AEGIS_DB_READ_POLICY=cue_or_evidence_only
AEGIS_RAM_LAST_REPLIES_SLOTS=20

# Keep Google paid routes off by default. Set both only if you explicitly want them.
AEGIS_ENABLE_GOOGLE_PAID=0
AEGIS_DISABLE_CLOUD=1

# Optional: Cloud-first pgvector backend with local Qdrant failover
AEGIS_FORCE_LOCAL_VECTOR=1
AEGIS_CLOUD_VECTOR_DSN=
AEGIS_VECTOR_MIRROR_LOCAL=1

# Remote compute lanes
# Use `gcloud` for the old GCP node or `ssh` for the Xeon-style self-hosted brain.
AEGIS_CLOUD_MANIFOLD_ENABLED=0
AEGIS_CLOUD_MANIFOLD_TRANSPORT=ssh
AEGIS_CLOUD_MANIFOLD_INSTANCE=ai-lean-node
AEGIS_CLOUD_MANIFOLD_ZONE=us-west1-b
AEGIS_CLOUD_MANIFOLD_HOST=
AEGIS_CLOUD_MANIFOLD_USER=<remote_user>
AEGIS_CLOUD_MANIFOLD_PORT=22
AEGIS_CLOUD_MANIFOLD_KEY_PATH=<USER_HOME>\.ssh\google_compute_engine
AEGIS_CLOUD_MANIFOLD_PYTHON=python3
AEGIS_CLOUD_MANIFOLD_REMOTE_DIR=/home/<remote_user>/Aegis_Agents
AEGIS_CLOUD_MANIFOLD_TEMP_DIR=/dev/shm/aegis
AEGIS_CLOUD_MANIFOLD_ALLOW_LOCAL_HANDS=0

# Project ALICE lane
AEGIS_ALICE_ENABLED=0
AEGIS_ALICE_TRANSPORT=ssh
AEGIS_ALICE_INSTANCE=ai-lean-node
AEGIS_ALICE_ZONE=us-west1-b
AEGIS_ALICE_HOST=
AEGIS_ALICE_USER=<remote_user>
AEGIS_ALICE_PORT=22
AEGIS_ALICE_KEY_PATH=<USER_HOME>\.ssh\google_compute_engine
AEGIS_ALICE_PYTHON=python3
AEGIS_ALICE_REMOTE_DIR=/home/<remote_user>/Aegis_Agents
AEGIS_ALICE_TEMP_DIR=/dev/shm/aegis
AEGIS_ALICE_MODEL=project-alice

# Secondary SSH swarm / fallback lane
AEGIS_XEON_ENABLED=0
AEGIS_XEON_HOST=
AEGIS_XEON_USER=<remote_user>
AEGIS_XEON_PORT=22
AEGIS_XEON_KEY_PATH=<USER_HOME>\.ssh\google_compute_engine
AEGIS_XEON_PYTHON=python3
AEGIS_XEON_REMOTE_DIR=/home/<remote_user>
AEGIS_XEON_TEMP_DIR=/dev/shm/aegis

# Optional: TimescaleDB connection
# DATABASE_URL=postgresql://user:password@localhost:5432/aegis_db
