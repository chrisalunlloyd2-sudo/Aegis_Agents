{
  "manifest_version": 3,
  "name": "Aegis-DIMON Gemini Optimizer",
  "version": "1.0",
  "description": "Native code-level dark theme and TimescaleDB sync for AEGIS.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["http://localhost:5000/*"]
}
